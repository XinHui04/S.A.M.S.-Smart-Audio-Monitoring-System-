# Local environment
.env
.env.*
!.env.example
# Firmware credentials. Matches secrets.h at ANY depth (the sketch lives in
# sams_iot/noprocess/), so a new sketch folder can never leak a key again.
secrets.h
!secrets.h.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / frontend
node_modules/
dist/
build/
.vite/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Runtime artifacts
sams_backend/sams.db
*.db-journal
*.db-wal
*.db-shm
sams_backend/audio_storage/
